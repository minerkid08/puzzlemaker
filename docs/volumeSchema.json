{
	"$schema": "https://json-schema.org/draft-07/schema#",
	"properties": {
		"minSize": {
			"$ref": "./utilsSchema.json#/$defs/vec3",
			"default": [
				0,
				0,
				0
			]
		},
		"maxSize": {
			"$ref": "./utilsSchema.json#/$defs/vec3",
			"default": [
				99999,
				99999,
				99999
			]
		},
		"defaultSize": {
			"$ref": "./utilsSchema.json#/$defs/vec3",
			"default": [
				4,
				4,
				4
			]
		},
		"editorTexture": {
			"$ref": "./utilsSchema.json#/$defs/editorTexture"
		},
		"entity": {
			"type": "string"
		}
	},
	"if": {
		"not": {
			"properties": {
				"noDefaultExport": {
					"const": true
				}
			},
			"required": [
				"noDefaultExport"
			]
		}
	},
	"then": {
		"properties": {
			"texture": {
				"$ref": "./utilsSchema.json#/$defs/texture"
			},
			"textures": {
				"type": "object",
				"properties": {
					"right": {
						"$ref": "./utilsSchema.json#/$defs/texture"
					},
					"left": {
						"$ref": "./utilsSchema.json#/$defs/texture"
					},
					"top": {
						"$ref": "./utilsSchema.json#/$defs/texture"
					},
					"bottom": {
						"$ref": "./utilsSchema.json#/$defs/texture"
					},
					"front": {
						"$ref": "./utilsSchema.json#/$defs/texture"
					},
					"back": {
						"$ref": "./utilsSchema.json#/$defs/texture"
					}
				},
				"required": [
					"right",
					"left",
					"top",
					"bottom",
					"front",
					"back"
				]
			}
		},
		"oneOf": [
			{
				"required": [
					"texture"
				]
			},
			{
				"required": [
					"textures"
				]
			}
		]
	}
}
